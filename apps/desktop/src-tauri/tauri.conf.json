{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CifraSync",
  "version": "0.6.0",
  "identifier": "com.cifrasync.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @cifrasync/web dev",
    "beforeBuildCommand": "pnpm --filter @cifrasync/web... build:native"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CifraSync",
        "width": 1200,
        "height": 800,
        "minWidth": 400,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb"],
    "category": "Music",
    "shortDescription": "Cifras, repertórios e teleprompter de palco",
    "longDescription": "Organize cifras e repertórios, compartilhe com a banda e toque no palco como teleprompter, mesmo sem internet.",
    "copyright": "MIT — arthurjosebona",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "COLE_AQUI_A_CHAVE_PUBLICA_DO_UPDATER",
      "endpoints": [
        "https://github.com/arthurjosebona/CifraSync/releases/latest/download/latest.json"
      ]
    }
  }
}
