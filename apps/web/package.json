    "@capacitor/share": "8.0.3",
    "@capacitor/status-bar": "8.0.4",
    "@cifrasync/core": "workspace:*",
    "@cifrasync/shared": "workspace:*",
    "@cifrasync/sync": "workspace:*",
    "@codemirror/commands": "^6.11.1",
