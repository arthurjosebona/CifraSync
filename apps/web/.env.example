# Copie para .env.local (nunca commite o .env real).

# Banco. Vazio = PGlite local em apps/web/.data (desenvolvimento sem instalar nada).
# Na Vercel, a integração da Neon preenche DATABASE_URL e DATABASE_URL_UNPOOLED.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Segredo das sessões (obrigatório em produção). Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL pública do app (opcional na Vercel; inferida de VERCEL_PROJECT_PRODUCTION_URL).
BETTER_AUTH_URL=

# Endereço da API usado pelos apps nativos (desktop/Android). Na web fica vazio (mesma origem).
VITE_API_URL=
