{
  "name": "@cifrasync/core",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target es2022 --tsconfig tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "data:build": "node scripts/build-chord-data.mjs",
    "review:voicings": "tsx scripts/review-voicings.ts"
  },
  "devDependencies": {
    "@tombatossals/chords-db": "0.5.1",
    "tsx": "^4.23.15"
  }
}
